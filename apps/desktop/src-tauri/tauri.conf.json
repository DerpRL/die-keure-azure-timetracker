{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Azure timetracker",
  "mainBinaryName": "AzureTimetracker",
  "version": "2.0.0",
  "identifier": "be.yarne.azure-timetracker",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Azure timetracker",
        "url": "index.html",
        "width": 1200,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 720,
        "center": true,
        "visible": false,
        "backgroundThrottling": "throttle"
      },
      {
        "label": "panel",
        "title": "Azure timetracker",
        "url": "index.html",
        "width": 420,
        "height": 640,
        "visible": false,
        "focus": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "backgroundThrottling": "throttle"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "publisher": "Yarne Savaete",
    "category": "Productivity",
    "shortDescription": "Keeps your 7pace Timetracker timer on the right Azure DevOps ticket.",
    "longDescription": "Azure timetracker watches your local Git branches and helps you keep your 7pace Timetracker timer on the right Azure DevOps ticket.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "bundleVersion": "25",
      "infoPlist": "Info.plist",
      "entitlements": "App.entitlements",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER-NOT-A-KEY: the release engineer replaces this with the base64 minisign public key from `tauri signer generate` before the first 2.x release",
      "endpoints": [
        "https://raw.githubusercontent.com/DerpRL/die-keure-azure-timetracker/main/updates/v2/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
