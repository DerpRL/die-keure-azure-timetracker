<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Azure timetracker @VERSION@</title>
  <organization>be.yarne.azure-timetracker</organization>
  <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <volume-check><allowed-os-versions><os-version min="14.0"/></allowed-os-versions></volume-check>
  <welcome file="Welcome.html" mime-type="text/html"/>
  <readme file="ReadMe.html" mime-type="text/html"/>
  <conclusion file="Conclusion.html" mime-type="text/html"/>
  <choices-outline><line choice="app"/></choices-outline>
  <choice id="app" visible="false" title="Azure timetracker"><pkg-ref id="be.yarne.azure-timetracker.pkg"/></choice>
  <pkg-ref id="be.yarne.azure-timetracker.pkg" version="@VERSION@" onConclusion="none">AzureTimetracker-component.pkg</pkg-ref>
  <pkg-ref id="be.yarne.azure-timetracker.pkg"><must-close><app id="be.yarne.azure-timetracker"/></must-close></pkg-ref>
</installer-gui-script>
