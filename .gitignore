.build*/
.swiftpm/
.DS_Store
.build-local/

# Generated installers and local application state
*.app/
*.dmg
*.pkg
*.zip
*.sha256
state.json
offline-drafts.json
time-edit-history.json
interface-preview-state.json
# Signing material and local environment values
.signing/
*.p12
*.pfx
*.key
*.mobileprovision
.env
.env.*

# Published installers are intentionally versioned in the public GitHub repository.
!releases/**/*.dmg
!releases/**/*.pkg
!releases/**/*.sha256

__pycache__/

# Deployment and update-signing secrets stay outside Git.
*.ed25519
*.pem
*.pub
id_rsa*
id_ed25519*
.keys/

!releases/updates/**/*.zip
